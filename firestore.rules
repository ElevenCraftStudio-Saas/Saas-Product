rules_version = '2';

// WedFind AI accesses data ONLY through the backend (FastAPI + Firebase Admin
// SDK) and AWS S3 — never directly from the client. The Admin SDK bypasses
// these rules, so deny all direct client access by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
