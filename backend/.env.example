# Copy to .env and fill in real values. NEVER commit the real .env.
# Required (app fails to boot if any is missing):
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/wedfind
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
ADMIN_EMAILS=owner@example.com
ENV=development          # production enables HTTPS redirect + strict CORS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
UPLOAD_DIR=../uploads
MATCH_THRESHOLD=0.6
FRONTEND_URL=http://localhost:3000

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=your-bucket
AWS_REGION=ap-south-1

# Firebase Admin (token verification uses public certs; service account optional)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS=firebase-service-account.json

# Guest consent version (DPDP audit)
CONSENT_VERSION=1.0

# Per-user quotas (admin can override each user; null column = use these defaults)
DEFAULT_EVENT_LIMIT=2
DEFAULT_STORAGE_LIMIT_MB=2048
