# Copy to .env and fill in real values. NEVER commit the real .env.
# Required (app fails to boot if any is missing):
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/wedfind
REDIS_URL=redis://localhost:6379/0
ENV=development          # production enables HTTPS redirect + strict CORS
UPLOAD_DIR=/app/uploads  # local upload storage (Docker-native path)
MATCH_THRESHOLD=0.6
FRONTEND_URL=http://localhost:3000

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=your-bucket
AWS_REGION=ap-south-1

# Firebase Admin SDK — three ways to provide the service-account key:
#   A. Place the file at backend/firebase-service-account.json (copied into image)
#   B. Set FIREBASE_SERVICE_ACCOUNT_B64 (base64-encoded JSON — shown below)
#   C. Set GOOGLE_APPLICATION_CREDENTIALS at runtime (Docker env / bind mount)
# Token verification (public certs) works without any of these.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS=firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_B64=$(base64 -w0 path/to/service-account.json)

# Guest consent version (DPDP audit)
CONSENT_VERSION=1.0

# Per-user quotas (admin can override each user; null column = use these defaults)
DEFAULT_EVENT_LIMIT=2
DEFAULT_STORAGE_LIMIT_MB=2048

# Roles are managed via Firestore (users/{uid} doc, field: role)
# Bootstrap the first admin with: python scripts/make_admin_firestore.py admin@email.com
