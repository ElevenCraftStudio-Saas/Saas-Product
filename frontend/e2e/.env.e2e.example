# Playwright E2E config — copy to frontend/.env.e2e and fill in.
# These tests hit the REAL stack; never point them at production data.

E2E_BASE_URL=http://localhost:3000

# A real Firebase studio account (role=user) used by auth.setup.ts.
E2E_STUDIO_EMAIL=studio.e2e@example.com
E2E_STUDIO_PASSWORD=change-me

# A live PUBLIC event slug whose uploaded photos include e2e/assets/selfie.jpg.
E2E_EVENT_SLUG=
# A past/closed event slug to exercise the expired route (optional).
E2E_EXPIRED_SLUG=

# Set to 1 only when real face images are present in e2e/assets/ (see README).
E2E_REAL_FACES=0

# Set to 1 to also run Firefox + WebKit.
E2E_ALL_BROWSERS=0

# Set to 1 to let Playwright boot `npm run start` itself.
E2E_START_SERVER=
