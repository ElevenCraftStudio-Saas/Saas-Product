#!/bin/bash
# WedFind host bootstrap (Amazon Linux 2023). Idempotent. Prepares the Docker
# host; the actual app deploy is driven by deploy/scripts/deploy.sh over SSM/SSH
# so application rollout stays decoupled from instance provisioning.
set -euxo pipefail

dnf update -y
dnf install -y docker amazon-cloudwatch-agent

# Ensure the SSM agent is present + running (no-op on standard AL2023 where it's
# preinstalled; required if a minimal AMI is ever used). Enables Session Manager.
dnf install -y amazon-ssm-agent || true
systemctl enable --now amazon-ssm-agent || true

# Docker + compose plugin
systemctl enable --now docker
usermod -aG docker ec2-user || true
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# App directory + deploy-time config the scripts read.
mkdir -p /opt/wedfind
cat > /opt/wedfind/deploy.conf <<EOF
APP_SECRET_NAME=${app_secret_name}
AWS_REGION=${region}
S3_BUCKET=${s3_bucket}
CW_LOG_GROUP=${log_group}
APP_DOMAIN=${app_domain}
EOF
chmod 600 /opt/wedfind/deploy.conf

# CloudWatch agent: ship Docker container logs + host metrics.
cat > /opt/aws/amazon-cloudwatch-agent/etc/wedfind.json <<EOF
{
  "agent": { "metrics_collection_interval": 60 },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/opt/wedfind/logs/*.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/app" }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "WedFind/${region}",
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] }
    }
  }
}
EOF
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/wedfind.json

echo "wedfind: host bootstrap complete. Run deploy/scripts/deploy.sh to roll out the app."
