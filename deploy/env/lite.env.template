# /opt/wedfind/.env on the lite host. Containers share this via env_file.
# DB/Redis point at the compose siblings, not AWS services.

DATABASE_URL=postgresql+psycopg://wedfind:<DB_PASSWORD>@db:5432/wedfind
REDIS_URL=redis://redis:6379/0

AWS_REGION=us-east-1
S3_BUCKET=<terraform output s3_bucket>
AWS_BUCKET_NAME=<same as S3_BUCKET — s3_service.py reads the legacy name>

FIREBASE_PROJECT_ID=saas-139a7
FIREBASE_SERVICE_ACCOUNT_B64=<base64 of service-account json>

SECRET_KEY=<openssl rand -hex 32>
FRONTEND_URL=https://wedfind.elevencraftstudio.com
ENV=production
USE_CELERY=true
LOG_JSON=true
ENABLE_METRICS=false

# compose interpolation (not read by the app)
DB_PASSWORD=<DB_PASSWORD>
BACKEND_IMAGE=<account>.dkr.ecr.us-east-1.amazonaws.com/wedfind-backend:<tag>
