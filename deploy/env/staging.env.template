# Reference for the runtime .env that fetch-secrets.sh renders on the host from
# Secrets Manager. You do NOT edit this on the host — it documents every key the
# app reads and where each comes from. Edit the SECRET, not the file.
#
# Source legend:  [secret]=from Secrets Manager  [role]=from EC2 IAM role
#                 [host]=set by deploy.conf/deploy.sh  [default]=app default

# --- Required (app fails to boot if missing) ---
DATABASE_URL=postgresql+psycopg://wedfind:<pw>@<rds-endpoint>:5432/wedfind  # [secret]
REDIS_URL=redis://<elasticache-endpoint>:6379/0                            # [secret]
AWS_REGION=ap-south-1                                                       # [secret]
S3_BUCKET=wedfind-staging-photos-<acct>                                     # [secret]
FIREBASE_PROJECT_ID=wedfind-xxxxx                                           # [secret]

# --- Firebase Admin credentials (one of these) ---
# Preferred: base64 of the service-account JSON. The app decodes it at startup
# and writes /app/firebase-service-account.json (chmod 600). Injected by the
# rotation runbook, never stored in Terraform state.
FIREBASE_SERVICE_ACCOUNT_B64=                                              # [secret]

# --- AWS credentials: intentionally UNSET. boto3 uses the EC2 instance role. ---
# AWS_ACCESS_KEY_ID=      # [role] do NOT set
# AWS_SECRET_ACCESS_KEY=  # [role] do NOT set

# --- Operational ---
ENV=production                 # [secret] HTTPS redirect + strict CORS
FRONTEND_URL=https://staging.wedfind.ai  # [secret] CORS origin(s), comma-separated
SENTRY_DSN=                    # [secret] error tracking (empty = disabled)
USE_CELERY=true                # [default]
LOG_JSON=true                  # [default] structured logs → CloudWatch
ENABLE_METRICS=true            # [default] /metrics for Prometheus

# --- Tunables (defaults are fine for staging) ---
MATCH_THRESHOLD=0.6            # [default]
DEFAULT_EVENT_LIMIT=2          # [default]
DEFAULT_STORAGE_LIMIT_MB=51200 # [default] 50 GB per studio
CONSENT_VERSION=1.0            # [default]
UPLOAD_DIR=/app/uploads        # [host] container path

# --- Compose-only (interpolation, not read by the app) ---
BACKEND_IMAGE=<registry>/wedfind-backend:<tag>  # [host] passed to deploy.sh
APP_DOMAIN=staging-api.wedfind.ai               # [host] Caddy TLS host
